{
  "title": "QX Scripter",
  "description": "C# scripting for G-Earth, with visual script panels and an MCP server for AI agents.",
  "authors": [{"name": "QDave"}],
  "version": "0.1.13",
  "categories": ["G-Earth Utilities", "Usability", "Others"],
  "source": "https://github.com/QDaves/QX-Scripter",
  "readme": "https://github.com/QDaves/QX-Scripter/blob/main/README.md",
  "releases": "https://github.com/QDaves/QX-Scripter/tags",
  "stable": true,
  "framework": {"name": "QX", "version": "0.0.22"},
  "language": "C#",
  "commands": {
    "default": ["cmd", "/C", "QX.exe", "-c", "{cookie}", "-p", "{port}", "-f", "{filename}", "--store"],
    "windows": ["cmd", "/C", "QX.exe", "-c", "{cookie}", "-p", "{port}", "-f", "{filename}", "--store"],
    "linux": ["/bin/sh", "-c", "chmod +x QX-linux-x64 && exec ./QX-linux-x64 -c \"$1\" -p \"$2\" -f \"$3\" --store >/dev/null 2>&1", "--", "{cookie}", "{port}", "{filename}"],
    "mac": ["/bin/sh", "-c", "if [ \"$(sysctl -n hw.optional.arm64 2>/dev/null)\" = 1 ]; then bin=QX-osx-arm64; else bin=QX-osx-x64; fi; chmod +x \"$bin\" && exec \"./$bin\" -c \"$1\" -p \"$2\" -f \"$3\" --store >/dev/null 2>&1", "--", "{cookie}", "{port}", "{filename}"]
  },
  "compatibility": {
    "systems": ["Windows", "Linux", "Mac"],
    "clients": ["Flash"]
  },
  "submissionDate": "14-09-2026 21:00:00",
  "updateDate": "06-10-2026 19:09:40",
  "isOutdated": false
}
